# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With no .env at all the server boots against
# in-process Postgres (PGlite), an offline Stripe double, and a Postgres-backed
# job poller -- and the full test suite passes. Set these to move to real infra.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Real Postgres. Unset => PGlite persisting to ./.data/pglite
# DATABASE_URL=postgres://billing:billing@localhost:5432/billing

# Stripe test mode. Unset => the offline double in src/stripe/fake.js
# STRIPE_SECRET_KEY=sk_test_...

# Endpoint secret from `stripe listen` or the Dashboard. The default below is
# used to sign AND verify offline, so the local flow exercises the real
# verification path.
STRIPE_WEBHOOK_SECRET=whsec_local_development_secret

# Replay window in seconds. Do not raise this in production.
STRIPE_WEBHOOK_TOLERANCE=300

# BullMQ. Unset => in-process poller against Postgres
# REDIS_URL=redis://localhost:6379

# Dunning: day offsets from the FIRST failure, and how many retries before
# the subscription is cancelled.
DUNNING_RETRY_DAYS=1,3,7
DUNNING_MAX_ATTEMPTS=3

JOB_POLL_INTERVAL_MS=15000
JOBS_ENABLED=true

# Email. Unset => notifications are logged to console and persisted to the
# notifications table.
EMAIL_FROM=billing@example.com
# RESEND_API_KEY=re_...
