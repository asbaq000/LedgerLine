{
  "name": "ledgerline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ledgerline - a SaaS subscription billing engine. Proration as a ledger, metered usage, webhook-driven state sync and dunning.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "stripe": "^17.5.0"
  },
  "optionalDependencies": {
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2"
  },
  "keywords": [
    "billing",
    "subscriptions",
    "proration",
    "stripe",
    "metered-usage",
    "dunning"
  ],
  "license": "MIT"
}
